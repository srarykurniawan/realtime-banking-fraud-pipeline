# Salin ke .env dan sesuaikan. Semua key settings.yaml bisa di-override: FRAUD__<SECTION>__<KEY>
FRAUD__ENVIRONMENT=production
FRAUD__SOURCE__TYPE=kafka
FRAUD__SOURCE__KAFKA_BOOTSTRAP_SERVERS=b-1.fraud-msk.xxxx.kafka.ap-southeast-3.amazonaws.com:9098
FRAUD__SOURCE__SECURITY_PROTOCOL=SASL_SSL
FRAUD__SOURCE__SASL_MECHANISM=AWS_MSK_IAM
FRAUD__STREAMING__CHECKPOINT_DIR=s3a://fraud-prod-lake-123456789012/checkpoints
FRAUD__STREAMING__BRONZE_DIR=s3a://fraud-prod-lake-123456789012/bronze
FRAUD__STREAMING__PUBLISH_ALERTS_TO_KAFKA=true
FRAUD__WAREHOUSE__TYPE=snowflake
FRAUD__WAREHOUSE__SNOWFLAKE__ACCOUNT=xy12345.ap-southeast-3.aws
FRAUD__WAREHOUSE__SNOWFLAKE__USER=SVC_FRAUD_STREAM
FRAUD__WAREHOUSE__SNOWFLAKE__PRIVATE_KEY_PATH=/var/run/secrets/snowflake/rsa_key.p8
FRAUD__MONITORING__EMITTER=cloudwatch
FRAUD__MONITORING__AWS_REGION=ap-southeast-3
